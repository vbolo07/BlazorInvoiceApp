name: dockercompose6358131647520595221
services:
  blazorappdb:
    container_name: blazor-app-db
    environment:
      MYSQL_ROOT_PASSWORD: example
    image: mysql
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "8002"
        protocol: tcp
    restart: always
  blazorinvoiceapp:
    build:
      context: C:\Users\Valentin\source\repos\Blazor
      dockerfile: BlazorInvoiceApp/Dockerfile
    container_name: blazor-invoice-app
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
    image: blazorinvoiceapp
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "8001"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Valentin\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Valentin\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose6358131647520595221_default